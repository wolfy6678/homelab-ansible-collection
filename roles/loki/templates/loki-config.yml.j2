# Managed by Ansible — do not edit on the host
# Single-binary Loki with filesystem storage — sized for a homelab, no object
# store or clustering. TSDB schema v13 + structured metadata (Alloy attaches
# GeoIP lat/lon as non-indexed metadata, so it does not inflate the label index).
auth_enabled: false

server:
  http_listen_port: {{ loki_port }}
  grpc_listen_port: 9096
  log_level: warn

common:
  instance_addr: 127.0.0.1
  path_prefix: {{ loki_data_dir }}
  storage:
    filesystem:
      chunks_directory: {{ loki_data_dir }}/chunks
      rules_directory: {{ loki_data_dir }}/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: filesystem
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: {{ loki_retention }}
  allow_structured_metadata: true
  volume_enabled: true
  # High-cardinality group-bys (per-src_ip panels) exceed the stock 500.
  max_query_series: {{ loki_max_query_series }}

querier:
  max_concurrent: {{ loki_querier_max_concurrent }}

compactor:
  working_directory: {{ loki_data_dir }}/compactor
  retention_enabled: true
  delete_request_store: filesystem

ruler:
  storage:
    type: local
    local:
      directory: {{ loki_data_dir }}/rules

# Homelab install — do not phone home.
analytics:
  reporting_enabled: false
