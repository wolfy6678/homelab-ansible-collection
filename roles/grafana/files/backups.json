          "expr": "homelab_backup_duration_seconds",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "title": "Backup Status",
      "transformations": [
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(instance|job_name|Value #.*)$"
            }
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "indexByName": {},
            "renameByName": {
              "instance": "Host",
              "job_name": "Job",
              "Value #A": "Since last success",
              "Value #B": "Exit code",
              "Value #C": "Duration"
            }
          }
        }
      ],
      "type": "table",
      "description": "One series per host and job — restic runs appear as job `restic`; any other job writing homelab_backup_* metrics into the textfile collector shows up here too."
