                    {
                      "color": "orange",
                      "value": 90000
                    },
                    {
                      "color": "red",
                      "value": 129600
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exit code"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "OK",
                        "color": "green",
                        "index": 0
                      }
                    }
                  },
                  {
                    "type": "range",
                    "options": {
                      "from": 1,
                      "to": 255,
                      "result": {
                        "text": "FAILED",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
