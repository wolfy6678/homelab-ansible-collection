# Managed by Ansible — do not edit on the host
#
# Project NOMAD management stack, adapted from upstream's
# install/management_compose.yaml. Differences, all deliberate:
#   - image tags are pinned (upstream tracks :latest with pull_policy: always)
#   - secrets come from the inventory instead of being generated on install
#   - the UI updater sidecar is omitted (see project_nomad_version's comment)
#
# Container names are part of NOMAD's contract — upstream's start/stop scripts
# and the admin itself find them by the nomad_ prefix — so keep them.
{#
  Values from the inventory go through env(): JSON-quoted so a secret holding
  `#`, `: ` or a quote can't break the YAML, and with `$` doubled so compose
  doesn't try to interpolate it as a variable.
#}
{% macro env(name, value) -%}
{{ (name ~ '=' ~ (value | string | replace('$', '$$'))) | to_json }}
{%- endmacro %}
name: project-nomad
services:
  admin:
    image: ghcr.io/crosstalk-solutions/project-nomad:v{{ project_nomad_version }}
    container_name: nomad_admin
    restart: unless-stopped
    extra_hosts:
      - "host.docker.internal:host-gateway"
    ports:
      - "{{ project_nomad_port }}:8080"
    volumes:
      # The admin reads the host side of this mount and hands the same path to
      # every child container it starts, so it must be a real host path.
      - {{ project_nomad_storage_dir }}:/app/storage
      - /var/run/docker.sock:/var/run/docker.sock
      # No nomad-update-shared volume: the admin treats that directory existing
      # as "the updater sidecar is present", and without the sidecar it would
      # queue UI updates nobody runs. Absent, the UI reports updates unavailable.
    environment:
      - NODE_ENV=production
      # Fallback for when the admin can't inspect its own mount; keep in sync.
      - NOMAD_STORAGE_PATH={{ project_nomad_storage_dir }}
      - PORT=8080
      - HOST=0.0.0.0
      - LOG_LEVEL={{ project_nomad_log_level }}
      - {{ env('APP_KEY', project_nomad_app_key) }}
      - {{ env('URL', project_nomad_url) }}
      - DB_HOST=mysql
      - DB_PORT=3306
      - DB_DATABASE=nomad
      - DB_USER=nomad_user
      - {{ env('DB_PASSWORD', project_nomad_db_password) }}
      - DB_NAME=nomad
      - DB_SSL=false
      - REDIS_HOST=redis
      - REDIS_PORT=6379
      - DISABLE_COMPRESSION=false
    depends_on:
      mysql:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/api/health"]
      interval: 30s
      timeout: 10s
      retries: 3
{% if project_nomad_dozzle_enabled | bool %}
  dozzle:
    image: {{ project_nomad_dozzle_image }}
    container_name: nomad_dozzle
    restart: unless-stopped
    ports:
      - "{{ project_nomad_dozzle_port }}:8080"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    environment:
      - DOZZLE_ENABLE_ACTIONS=false
      - DOZZLE_ENABLE_SHELL=false
{% endif %}
  mysql:
    image: {{ project_nomad_mysql_image }}
    container_name: nomad_mysql
    restart: unless-stopped
    environment:
      - {{ env('MYSQL_ROOT_PASSWORD', project_nomad_db_root_password) }}
      - MYSQL_DATABASE=nomad
      - MYSQL_USER=nomad_user
      - {{ env('MYSQL_PASSWORD', project_nomad_db_password) }}
    volumes:
      - {{ project_nomad_dir }}/mysql:/var/lib/mysql
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost"]
      interval: 30s
      timeout: 10s
      retries: 10
  redis:
    image: {{ project_nomad_redis_image }}
    container_name: nomad_redis
    restart: unless-stopped
    volumes:
      - {{ project_nomad_dir }}/redis:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 30s
      timeout: 10s
      retries: 3
  disk-collector:
    # Read-only view of the host filesystem so the UI can show disk usage.
    image: ghcr.io/crosstalk-solutions/project-nomad-disk-collector:v{{ project_nomad_disk_collector_version }}
    container_name: nomad_disk_collector
    restart: unless-stopped
    volumes:
      - /:/host:ro,rslave
      - {{ project_nomad_storage_dir }}:/storage
